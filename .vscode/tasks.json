{
  "version": "2.0.0",
  "tasks": [
    { "label": "Install requirements", "type": "shell",
      "command": "python -m pip install -r app/requirements.txt -r tools/requirements.txt" },
    { "label": "Build Word documents", "type": "shell", "command": "python tools/build_docx.py" },
    { "label": "Run tests", "type": "shell", "command": "python -m unittest discover -s tests -v",
      "options": { "cwd": "${workspaceFolder}/app" }, "group": "test" }
  ]
}
