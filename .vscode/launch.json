{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Clinic web app (Flask)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "cwd": "${workspaceFolder}/app",
      "args": ["--app", "clinic", "run", "--debug"],
      "jinja": true
    },
    {
      "name": "Create database (init-db --seed)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "cwd": "${workspaceFolder}/app",
      "args": ["--app", "clinic", "init-db", "--seed"]
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "cwd": "${workspaceFolder}/app",
      "args": ["discover", "-s", "tests", "-v"]
    },
    {
      "name": "Rebuild PM charts and Word documents",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/pm_calculations.py",
      "cwd": "${workspaceFolder}",
      "postDebugTask": "Build Word documents"
    }
  ]
}
